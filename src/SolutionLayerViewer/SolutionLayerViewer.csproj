<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SolutionLayerViewer</RootNamespace>
    <AssemblyName>SolutionLayerViewer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Product>Solution Layer Viewer for XrmToolBox</Product>
    <Description>Lists the components of a Dataverse solution and shows the solution layer stack for each component.</Description>
    <Company>maaswerk</Company>
    <Copyright>Copyright (c) maaswerk</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.10.74" />
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.9.64" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
