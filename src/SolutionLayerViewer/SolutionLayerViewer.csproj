<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SolutionLayerViewer</RootNamespace>
    <AssemblyName>SolutionLayerViewer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Product>Solution Layer Viewer for XrmToolBox</Product>
    <Description>Lists the components of a Dataverse solution and shows the solution layer stack for each component.</Description>
    <Company>maaswerk</Company>
    <Copyright>Copyright (c) maaswerk</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.51" />
    <PackageReference Include="XrmToolBox.Extensibility" Version="4.0.0" />
  </ItemGroup>

</Project>
